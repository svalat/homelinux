
{
	"api" : 1,
	"configure" : 
	{
		"" : 
		[
			"--enable-from-quick",
			"--enable-prefix-conf",
			"--this-come-from-home"
		],
		"+gentoo" : [ "--with-curses", "--disable-profiling" ],
		"afs" : [ "--$with-afs" ],
		"mem-scramble" : [ "--$enable-mem-scramble", "--$with-bash-malloc" ],
		"net" : [ "--$enable-net-redirections" ],
		"readline" : [ "--$enable-readline", "--$enable-history", "--$enable-bang-history" ],
		"static" : [ "--enable-prefix-conf-static" ]
	},
	"conflicts" : null,
	"deps" : 
	[
		"sys-libs/ncurses",
		"readline? sys-libs/readline",
		"nls? virtual/libintl"
	],
	"flags" : 
	{
		"CFLAGS" : [ "-O3 -march=native" ],
		"CXXFLAGS" : [ "$CFLAGS" ],
		"MAKEOPTS" : [ "-j4", "-j8" ]
	},
	"homepage" : "http://tiswww.case.edu/php/chet/bash/bashtop.html",
	"host" : 
	{
		"centos7" : [ "bash" ],
		"debian8" : [ "bash" ],
		"default" : true,
		"gentoo" : [ "app-shells/bash" ]
	},
	"inherit" : "models/auto",
	"md5" : null,
	"module" : "",
	"multiconfigure" : null,
	"name" : "hl/app-shells/bash",
	"patch" : null,
	"scripts" : [ "models/scripts/default.sh" ],
	"slots" : null,
	"steps" : 
	{
		"build" : [ "hl_build" ],
		"check" : [ "hl_check" ],
		"clean" : [ "hl_clean" ],
		"configure" : [ "hl_configure_autotools" ],
		"download" : [ "hl_download" ],
		"extract" : [ "hl_extract" ],
		"fullpipeline" : [ "@prebuild", "@singlebuild", "@postbuild" ],
		"install" : [ "hl_install" ],
		"main" : [ "@fullpipeline" ],
		"manifest" : [ "hl_manifest" ],
		"merge" : [ "hl_merge" ],
		"module" : [ "hl_module" ],
		"patch" : [ "hl_patch" ],
		"postbuild" : [ "@merge", "@module", "@postinstall", "@clean" ],
		"postinstall" : null,
		"prebuild" : 
		[
			"@download",
			"@check",
			"@preinstall",
			"@extract",
			"@patch",
			"@prepare"
		],
		"preinstall" : null,
		"prepare" : null,
		"singlebuild" : [ "@configure", "@build", "@test", "@install", "@manifest" ],
		"test" : null
	},
	"subdir" : "bash-${VERSION}",
	"urls" : [ "http://ftp.gnu.org/gnu/bash//bash-${VERSION}.tar.gz" ],
	"use" : 
	[
		"+afs",
		"+static",
		"-net",
		"gentoo",
		"ls",
		"mem-scramble",
		"nls",
		"readline"
	],
	"vars" : null,
	"version" : "4.3.48",
	"versions" : [ "4.3.48", "4.4.35", "4.5.20" ],
	"vfetcher" : 
	{
		"mode" : "ftp",
		"regexp" : "bash-([0-9]+\\.[0-9]+).tar.gz",
		"subdir" : null,
		"url" : "http://ftp.gnu.org/gnu/bash/",
		"urls" : null
	},
	"vspecific" : null,
	"warn" : null
}
