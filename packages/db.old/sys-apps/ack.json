{
	"name": "sys-apps/ack",
	"homepage": "http://betterthangrep.com/",
	"versions": [
		"2.18"
	],
	"inherit": "models/perl",
	"vfetcher": {
		"mode": "http",
		"url": "https://metacpan.org/dist/ack",
		"regexp": "v([0-9]+.[0-9]+.?[0-9]*.?[0-9]*)",
		"enclose": false,
		"tag": "option"
	},
	"md5": {},
	"subdir": "ack-${VERSION}",
	"urls": [
		"http://search.cpan.org/CPAN/authors/id/P/PE/PETDANCE/ack-${VERSION}.tar.gz"
	],
	"deps": [
		"dev-perl/File-Next",
		"test? dev-perl/IO-Tty"
	],
	"configure": {},
	"use": [
		"test"
	],
	"host": {
		"default": false,
		"debian8": [
			"ack"
		],
		"centos7": [
			"ack"
		],
		"gentoo": [
			"sys-apps/ack"
		]
	}
}
