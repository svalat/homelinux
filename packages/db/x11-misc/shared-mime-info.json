{
	"name": "x11-misc/shared-mime-info",
	"homepage": "http://freedesktop.org/wiki/Software/shared-mime-info",
	"versions": [
		"1.5"
	],
	"inherit": "models/autotools",
	"vfetcher": {
		"mode": "gitlab",
		"url": "gitlab://gitlab.freedesktop.org/xdg/shared-mime-info",
		"regexp": "([0-9]+\\.[0-9]+\\.?[0-9]*\\.?[0-9]*)"
	},
	"md5": {},
	"subdir": "shared-mime-info-${VERSION}",
	"urls": [
		"hhttps://gitlab.freedesktop.org/xdg/shared-mime-info/-/archive/${VERSION}/shared-mime-info-${VERSION}.tar.bz"
	],
	"deps": [
		"dev-libs/glib :2",
		"dev-libs/libxml2",
		"dev-util/intltool",
		"sys-devel/gettext",
		"virtual/pkgconfig"
	],
	"configure": {
		"test": [
			"--$enable-default-make-check"
		],
		"": [
			"--disable-update-mimedb"
		]
	},
	"use": [
		"test"
	],
	"host": {
		"default": false,
		"debian8": [
			"shared-mime-info"
		],
		"centos7": [
			"shared-mime-info"
		],
		"gentoo": [ "x11-misc/shared-mime-info" ]
	},
	"vars": {
		"HL_MAKEOPTS": ""
	}
}
