{
	"name": "app-arch/xz-utils",
	"homepage": "http://tukaani.org/xz/",
	"inherit": "models/autotools",
	"vfetcher": {
		"mode": "github",
		"url": "github://tukaani-project/xz",
		"regexp": "v([0-9]+\\.[0-9]+\\.?[0-9]*\\.?[0-9]*)"
	},
	"md5": {},
	"subdir": "xz-${VERSION}",
	"urls": [
		"http://tukaani.org/xz/xz-${VERSION}.tar.gz"
	],
	"deps": [
		"app-arch/lzma",
		"app-arch/p7zip"
	],
	"configure": {
		"nls": [
			"--$enable-nls"
		],
		"threads": [
			"--$enable-threads"
		],
		"static-libs": [
			"--$enable-static"
		],
		"": [
		]
	},
	"use": [
		"elibc_FreeBSD",
		"nls",
		"static-libs",
		"+threads"
	],
	"host": {
		"default": false,
		"debian8": [
			"xz-utils"
		],
		"centos7": [ "xz", "xz-libs", "xz-devel" ],
		"gentoo": [ "app-arch/xz-utils" ]
	},
	"tested": {
		"centos7": "5.2.3"
	},
	"versions": [
		"5.8.3",
		"5.8.2",
		"5.8.1",
		"5.8.0",
		"5.6.4",
		"5.6.3",
		"5.6.2",
		"5.4.7",
		"5.4.6",
		"5.4.5",
		"5.4.4",
		"5.4.3",
		"5.4.2",
		"5.4.1",
		"5.4.0",
		"5.2.13",
		"5.2.12",
		"5.2.11",
		"5.2.10"
	]
}
