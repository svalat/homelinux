{
	"name": "app-arch/lzma",
	"homepage": "http://www.7-zip.org/sdk.html",
	"inherit": "models/default",
	"vfetcher": {
		"mode": "http",
		"url": "http://www.7-zip.org/sdk.html",
		"regexp": "([0-9]+.[0-9]+.?[0-9]*.?[0-9]*):",
		"tag": "b"
	},
	"md5": {},
	"subdir": "./",
	"urls": [
		"http://www.7-zip.org/a/lzma$(echo $VERSION | sed -e 's/\\.//g').7z"
	],
	"deps": [ "p7zip" ],
	"configure": {},
	"use": [
		"doc"
	],
	"host": {
		"default": false,
		"debian8": [
			"lzma"
		],
		"centos7": false,
		"gentoo": [ "app-arch/lzma" ]
	},
	"steps": {
		"configure":[],
		"build": [
			"run_sh cd CPP/7zip/Bundles/LzmaCon",
			"run make -f makefile.gcc"
		],
		"install": [
			"run cp lzma $PREFIX/bin/lzma"
		]
	},
	"tested": {
		"centos7": "16.04"
	},
	"vspecific": {
		">=23.01": {
			"steps": {
				"install": [
					"run cp _o/lzma $PREFIX/bin/lzma"
				]
			}
		}
	},
	"versions": [
		"26.01",
		"26.00",
		"25.01",
		"25.00",
		"24.09",
		"24.05",
		"23.01",
		"21.07",
		"21.06",
		"19.00",
		"18.06",
		"18.05",
		"18.01",
		"16.02",
		"9.35",
		"9.20",
		"9.11",
		"9.04",
		"4.62"
	]
}
