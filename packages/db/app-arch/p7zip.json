{
	"name": "app-arch/p7zip",
	"homepage": "http://p7zip.sourceforge.net/",
	"inherit": "models/default",
	"vfetcher": {
		"mode": "github",
		"url": "github://ip7z/7zip",
		"regexp": "v?([0-9]+\\.[0-9]+\\.?[0-9]*\\.?[0-9]*)"
	},
	"md5": {},
	"subdir": ".",
	"urls": [
		"https://github.com/ip7z/7zip/releases/download/${VERSION}/7z$(echo ${VERSION} | sed -e 's/\\.//g')-src.tar.xz"
	],
	"deps": [
		"kde? x11-libs/wxGTK:3.0[X] kde-base/kdelibs",
		"wxwidgets? x11-libs/wxGTK:3.0[X]",
		"amd64? dev-lang/yasm",
		"abi_x86_x32? dev-lang/yasm",
		"x86? dev-lang/nasm"
	],
	"configure": {},
	"use": [
		"x86",
		"amd64",
		"doc",
		"kde",
		"rar",
		"+pch",
		"static",
		"wxwidgets",
		"abi_x86_x32"
	],
	"steps": {
		"configure": [],
		"build": [
			"run_sh cd CPP/7zip/Bundles/Alone",
			"run make -f makefile.gcc -j8 CC=gcc CXX=g++",
			"run_sh cd ../Alone2",
			"run make -f makefile.gcc -j8 CC=gcc CXX=g++",
			"run_sh cd ../Format7zF",
			"run make -f makefile.gcc -j8 CC=gcc CXX=g++",
			"run_sh cd ../../../../"
		],
		"install": [
			"run mkdir -p ${HL_PREFIX}/bin",
			"run cp CPP/7zip/Bundles/Alone/_o/7za ${HL_PREFIX}/bin",
			"run cp CPP/7zip/Bundles/Alone2/_o/7zz ${HL_PREFIX}/bin/7z",
			"run cp CPP/7zip/Bundles/Alone2/_o/7zz ${HL_PREFIX}/bin/p7zip",
			"run mkdir -p ${HL_PREFIX}/lib64/p7zip",
			"run cp CPP/7zip/Bundles/Format7zF/_o/7z.so ${HL_PREFIX}/lib64/p7zip/",
			"run cp CPP/7zip/Bundles/Alone/_o/7za ${HL_PREFIX}/lib64/p7zip/",
			"run cp CPP/7zip/Bundles/Alone2/_o/7zz ${HL_PREFIX}/lib64/p7zip/7z",
			"run cp CPP/7zip/Bundles/Alone2/_o/7zz ${HL_PREFIX}/lib64/p7zip/p7zip"
		]
	},
	"host": {
		"default": false,
		"debian8": [
			"p7zip"
		],
		"centos7": false,
		"gentoo": [ "app-arch/p7zip" ]
	},
