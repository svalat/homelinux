{
	"name": "app-arch/tar",
	"homepage": "https://www.gnu.org/software/tar/tar.html",
	"inherit": "models/autotools",
	"vfetcher": {
		"mode": "http",
		"url": "mirror://http-gnu/gnu/tar/",
		"regexp": "tar-([0-9]+.[0-9]+.?[0-9]*.?[0-9]*).tar.gz"
	},
	"md5" : {},
	"subdir": "tar-${VERSION}",
	"urls" : [
		"mirror://http-gnu/gnu/tar/tar-${VERSION}.tar.gz"
	],
	"deps": [
		"acl? virtual/acl",
		"selinux? sys-libs/libselinux",
		"nls? sys-devel/gettext",
		"xattr? sys-apps/attr"
	],
	"configure": {
		"+gentoo": [ "--enable-backup-scripts" ],
		"acl": [ "--$enable-posix-acks" ],
		"nls": [ "--$enable-nls" ],
		"elinux": [ "--$enable-selinux" ],
		"xattr": [ "--$enable-xattrs" ]
	},
	"host": {
		"default": false,
		"debian8": [ "tar" ],
		"centos7": [ "tar" ],
		"gentoo": [ "app-arch/tar" ]
	},
	"use": [ 
		"gentoo",
		"acl",
		"selinux",
		"nls",
		"xattr",
		"elinux"
	],
	"tested": {
		"centos7": "1.29"
	},
	"versions": [ 
		"1.35",
		"1.34",
		"1.33",
		"1.32",
		"1.31",
		"1.30",
		"1.29",
		"1.28",
		"1.27.1",
		"1.27",
		"1.26",
		"1.25",
		"1.24",
		"1.23",
		"1.22",
		"1.21",
		"1.20",
		"1.19",
		"1.18",
		"1.17",
		"1.16.1",
		"1.16",
		"1.15.1",
		"1.15",
		"1.14",
		"1.13",
		"1.12",
		"1.11.8"
	]
}
