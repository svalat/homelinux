{
	"name": "dev-lang/tk",
	"homepage": "http://www.tcl.tk/",
	"inherit": "models/autotools",
	"vfetcher": {
		"mode": "ftp",
		"url": "ftp://ftp.tcl.tk/pub/tcl/tcl8_6/",
		"regexp": "tk([0-9]+\\.[0-9]+\\.?[0-9]*\\.?[0-9]*)-src.(tar.bz2|tar.gz|tbz|tar.xz)"
	},
	"md5": {},
	"subdir": "tk${VERSION}/unix",
	"urls": [
		"sourceforge://tcl/Tcl/${VERSION}/tk${VERSION}-src.tar.gz"
	],
	"deps": [
		"-aqua? media-libs/fontconfig",
		"-aqua? x11-libs/libX11",
		"-aqua? x11-libs/libXt",
		"-aqua&truetype? x11-libs/libXft",
		"-aqua&xscreensaver? x11-libs/libXScrnSaver",
		"dev-lang/tcl"
	],
	"configure": {
		"": [
			"--with-tcl=$(hl prefix-of dev-lang/tcl)/lib"
		],
		"aqua": [
			"--$enable-aqua"
		],
		"truetype": [
			"--$enable-xft"
		],
		"xscreensaver": [
			"--$enable-xss"
		],
		"debug": [
			"--$enable-symbols"
		]
	},
	"use": [
		"debug",
		"truetype",
		"aqua",
		"xscreensaver"
	],
	"host": {
		"default": false,
		"debian8": [
			"tk", "tk-dev"
		],
		"centos7": [
			"tk", "tk-devel"
		],
		"gentoo": [ "dev-lang/tk" ]
	},
	"slots": {
		"~" : "([0-9]+.[0-9]+)"
	},
