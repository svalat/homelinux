{
	"name": "dev-libs/libxml2",
	"homepage": "http://www.xmlsoft.org/",
	"inherit": "models/autotools",
	"vfetcher": {
		"mode": "html",
		"url": "http://xmlsoft.org/ftp/libxml2/",
		"regexp": "libxml2-([0-9]+\\.[0-9]+\\.?[0-9]*\\.?[0-9]*).(tar.bz2|tar.gz|tbz|tar.xz)"
	},
	"md5": {},
	"subdir": "libxml2-${VERSION}",
	"urls": [
		"http://xmlsoft.org/ftp/libxml2/libxml2-${VERSION}.tar.gz"
	],
	"deps": [
		"dev-util/gtk-doc-am",
		"virtual/pkgconfig",
		"python? dev-lang/python",
		"sys-libs/zlib",
		"hppa? sys-devel/binutils",
		"icu? dev-libs/icu",
		"lzma? app-arch/xz-utils",
		"readline? sys-libs/readline"
	],
	"configure": {
		"": [
			"--with-html-subdir=/html",
			"--exec-prefix=$PREFIX"
		],
		"python": [
			"--$with-python"
		],
		"debug": [
			"--$with-run-debug="
		],
		"icu": [
			"--$with-icu"
		],
		"lzma": [
			"--$with-lzma"
		],
		"ipv6": [
			"--$enable-ipv6"
		],
		"static-libs": [
			"--$enable-static"
		]
	},
	"use": [
		"debug",
		"examples",
		"icu",
		"ipv6",
		"lzma",
		"-python",
		"readline",
		"static-libs",
		"test",
		"hppa",
		"python"
	],
	"host": {
		"default": false,
		"debian8": [
			"libxml2", "libxml2-dev"
		],
		"centos7": [
			"libxml2", "libxml2-devel"
		],
		"gentoo": [
			"dev-libs/libxml2"
		]
	},
	"versions": [
		"2.9.12",
		"2.9.11",
		"2.9.10",
		"2.9.9",
		"2.9.8",
		"2.9.7",
		"2.9.6",
		"2.9.5",
		"2.9.4",
		"2.9.3",
		"2.9.2",
		"2.9.1",
		"2.9.0",
		"2.8.0",
		"2.7.8",
		"2.7.7",
		"2.7.6",
		"2.7.5",
		"2.7.4",
		"2.7.3",
		"2.7.2"
	]
}
