{
	"name": "dev-libs/libxslt",
	"homepage": "http://www.xmlsoft.org/",
	"inherit": "models/autotools",
	"versions": [ 
		"1.1.28" 
	],
	"vfetcher": {
		"mode": "http-gnome-cache",
		"url": "https://download.gnome.org/sources/libxslt/cache.json",
		"regexp": "libxslt-([0-9]+\\.[0-9]+\\.?[0-9]*\\.?[0-9]*).tar.gz"
	},
	"md5" : {},
	"subdir": "libxslt-${VERSION}",
	"urls" : [
		"github://GNOME/libxslt"
	],
	"deps": [
		"dev-libs/libxml2"
	],
	"configure": {
	},
	"host": {
		"default": false,
		"debian8": [ "libxslt1-dev" ],
		"centos7": [ "libxslt", "libxslt-devel" ],
		"gentoo": [ "dev-libs/libxslt" ]
	}
}
