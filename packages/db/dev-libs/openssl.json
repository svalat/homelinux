{
	"name": "dev-libs/openssl",
	"homepage": "https://www.openssl.org",
	"inherit": "models/autotools",
	"vfetcher": {
		"mode": "github",
		"url": "github://openssl/openssl",
		"regexp": "openssl-([0-9]+\\.[0-9]+\\.[0-9]+(-[a-z0-9]+)?)"
	},
	"md5" : {},
	"subdir": "openssl-${VERSION}",
	"urls" : [
		"https://www.openssl.org/source/openssl-${VERSION}.tar.gz"
	],
	"deps": [
	],
	"use": [
		"static-libs"
	],
	"configure": {
		"": [
		]
	},
	"steps": {
		"configure": [
			"./Configure --prefix=$HL_PREFIX linux-x86_64 shared"
		],
		"install": [
			"run make install_sw"
		]
	},
	"host": {
		"default": false,
		"debian8": [ "openssl", "openssl-dev" ],
		"centos7": [ "openssl", "openssl-devel" ],
		"gentoo": [ "dev-libs/openssl" ]
	},
	"versions": [ 
		"4.0.0",
		"4.0.0-beta1",
		"4.0.0-alpha1",
		"3.6.2",
		"3.6.1",
		"3.6.0",
		"3.6.0-beta1",
		"3.6.0-alpha1",
		"3.5.6",
		"3.5.5",
