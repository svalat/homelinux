{
	"name": "net-libs/gnutls",
	"homepage": "http://www.gnutls.org/",
	"inherit": "models/autotools",
	"vfetcher": {
		"subdir": {
			"mode": "html",
			"url": "https://www.gnupg.org/ftp/gcrypt/gnutls/",
			"regexp": "v([0-9]+\\.[0-9]+\\.?[0-9]*\\.?[0-9]*)"
		},
		"mode": "html",
		"url": "https://www.gnupg.org/ftp/gcrypt/gnutls/v${SVERSION}/",
		"regexp": "gnutls-([0-9]+\\.[0-9]+\\.?[0-9]*\\.?[0-9]*).tar.((bz2)|(xz))",
		"enclose": false
	},
	"md5" : {},
	"subdir": "gnutls-${VERSION}",
	"urls" : [
		"https://www.gnupg.org/ftp/gcrypt/gnutls/v$(echo ${VERSION} | cut -f 1-2 -d '.')/gnutls-${VERSION}.tar.xz"
	],
	"deps": [
		"dev-libs/nettle",
		"dev-libs/gmp",
		"dev-libs/libtasn1",
		"net-dns/libidn2",
		"net-dns/unbound",
		"app-crypt/p11-kit"
	],
	"configure": {
		"": [ 
			"$(hl_with p11-kit app-crypt/p11-kit)", 
			"LDFLAGS=-L$HL_PREFIX/lib" ]
	},
	"host": {
		"default": false,
		"debian8": [ "gnutls-bin" ],
		"centos7":  [ "gnutls", "gnutls-devel" ],
		"gentoo": [ "net-libs/gnutls" ]
