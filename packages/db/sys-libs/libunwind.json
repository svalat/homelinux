{
	"api": 1,
	"name": "sys-libs/libunwind",
	"homepage": "https://savannah.nongnu.org/projects/libunwind",
	"inherit": "models/autotools",
	"vfetcher": {
		"mode": "http",
		"url": "https://download.savannah.nongnu.org/releases/libunwind/",
		"regexp": "libunwind-([0-9]+.[0-9]+.?[0-9]*.?[0-9]*).(tar.bz2|tar.gz|tbz|tar.xz)"
	},
	"md5": {},
	"subdir": "libunwind-${VERSION}",
	"urls": [
		"https://download.savannah.nongnu.org/releases/libunwind/libunwind-${VERSION}.tar.gz",
		"https://github.com/libunwind/libunwind/releases/download/v${VERSION}/libunwind-${VERSION}.tar.gz"
	],
	"deps": [
		"lzma? app-arch/xz-utils",
		"libatomic? dev-libs/libatomic_ops"
	],
	"configure": {
		"gentoo": [
			"--enable-cxx-exceptions",
			"--enable-coredump",
			"--enable-ptrace",
			"--enable-setjmp"
		],
		"debug-frame": [
			"--$enable-debug-frame"
		],
		"doc": [
			"--$enable-documentation"
		],
		"lzma": [
			"--$enable-minidebuginfo"
		],
		"static-libs": [
			"--$enable-static"
		],
		"debug": [
			"--$enable-conservative_checks",
			"--$enable-debug"
		]
	},
	"use": [
		"gentoo",
		"debug",
		"debug-frame",
		"doc",
		"libatomic",
		"lzma",
		"static-libs"
	],
	"host": {
		"default": false,
		"debian8": [
			"libunwind"
		],
		"centos7": [
			"libunwind"
		],
		"gentoo": [
			"sys-libs/libunwind"
		]
	},
	"versions": [
		"1.6.2",
		"1.6.1",
		"1.6.0",
		"1.5.0",
		"1.4.0",
		"1.3.2",
		"1.3.1",
		"1.3.0",
		"1.2.1",
		"1.2",
		"1.1",
		"1.0.1",
		"1.0",
		"0.99",
		"0.98.6",
		"0.98.5",
		"0.98.4",
		"0.98.3",
		"0.98.2",
		"0.98.1",
		"0.98",
		"0.97",
		"0.96",
		"0.95",
		"0.93",
		"0.92",
		"0.91",
		"0.9",
		"0.1",
		"0.0"
	]
}
