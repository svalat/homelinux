{
	"name": "sys-libs/libcap",
	"homepage": "https://sites.google.com/site/fullycapable/",
	"versions": [
		"2.24"
	],
	"inherit": "models/autotools",
	"vfetcher": {
		"mode": "http",
		"url": "https://sites.google.com/site/fullycapable/release-notes-for-libcap",
		"regexp": "Release notes for ([0-9]+\\.[0-9]+\\.?[0-9]*\\.?[0-9]*)",
		"enclose": true
	},
	"md5": {},
	"subdir": "libcap-${VERSION}",
	"urls": [
		"https://git.kernel.org/pub/scm/libs/libcap/libcap.git/snapshot/libcap-${VERSION}.tar.gz"
	],
	"deps": [
		"sys-apps/attr",
		"TODO? sys-kernel/linux-headers",
		"pam? virtual/pam"
	],
	"configure": {},
	"use": [
		"pam",
		"static-libs",
		"-TODO"
	],
	"host": {
		"default": false,
		"debian8": [
			"libcap-dev"
		],
		"centos7": [ "libcap", "libcap-devel" ],
		"gentoo": [ "sys-libs/libcap" ]
	}
}
