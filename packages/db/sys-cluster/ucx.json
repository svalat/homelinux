	],
	"host": {
		"default": false,
		"debian8": [ "libuxc" ],
		"centos7": [ "libuxc", "libuxc-devel" ],
		"gentoo": [ "sys-cluster/ucx" ]
	},
	"versions": [ 
		"1.20.1",
		"1.20.0",
		"1.19.1",
		"1.19.0",
		"1.18.1",
		"1.18.0",
		"1.17.0",
		"1.16.0",
		"1.11.1"
	]
}
