{
	"name": "sys-cluster/dlb",
	"homepage": "https://pm.bsc.es/dlb",
	"inherit": "models/autotools",
	"vfetcher": {
		"mode": "http",
		"url": "https://pm.bsc.es/dlb-downloads",
		"regexp": "dlb-([0-9]+\\.[0-9]+\\.?[0-9]*).tar.gz"
	},
	"md5" : {},
	"subdir": "dlb-${VERSION}",
	"urls" : [
		"https://pm.bsc.es/ftp/dlb/releases/dlb-${VERSION}.tar.gz"
	],
	"deps": [
		"mpi? virtual/mpi"
	],
	"use": [
		"+mpi"
	],
	"host": {
		"default": false,
		"debian8": false,
		"centos7": false,
		"gentoo": false
	},
	"configure": {
		"mpi": [ "--$enable-mpi" ]
	},
	"versions": [
