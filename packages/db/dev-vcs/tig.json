{
	"name": "dev-vcs/tig",
	"homepage": "http://jonas.nitro.dk/tig/",
	"inherit": "models/autotools",
	"vfetcher": {
		"mode": "github",
		"url": "github://jonas/tig",
		"regexp": "tig-([0-9]+\\.[0-9]+\\.?[0-9]*\\.?[0-9]*)"
	},
	"md5" : {},
	"subdir": "tig-${VERSION}",
	"urls" : [
		"https://github.com/jonas/tig/releases/download/tig-${VERSION}/tig-${VERSION}.tar.gz"
	],
	"deps": [
		"sys-libs/ncurses"
	],
	"configure": {
		"": [
			"--with-ncurses=$(hl prefix-of sys-libs/ncurses)",
			"LDFLAGS=-L$(hl prefix-of sys-libs/ncurses)/lib"
		]
	},
	"host": {
		"default": false,
		"debian8": [ "tig" ],
		"centos7": [ "tig" ],
		"gentoo": [ "dev-vcs/tig" ]
	},
	"versions": [ 
		"2.6.0",
		"2.5.12",
		"2.5.11",
		"2.5.10",
		"2.5.9",
		"2.5.8",
		"2.5.7",
		"2.5.6",
		"2.5.5",
		"2.5.4",
		"2.5.3",
		"2.5.2",
		"2.5.1",
		"2.5.0",
		"2.4.1",
		"2.4.0",
		"2.3.3",
		"2.3.2",
		"2.3.1",
		"2.3.0",
		"2.2.2",
		"2.2.1",
		"2.2",
		"2.1.1",
		"2.1",
		"2.0.3",
		"2.0.2",
		"2.0.1",
		"2.0",
		"1.2.1"
	]
}
