{
	"name": "sys-process/htop",
	"homepage": "http://hisham.hm/htop",
	"inherit": "models/autotools",
	"vfetcher": {
		"mode": "github",
		"url": "github://htop-dev/htop",
		"regexp": "([0-9]+.[0-9]+.?[0-9]*)"
	},
	"md5" : {},
	"subdir": "htop-${VERSION}",
	"urls" : [
		"https://github.com/htop-dev/htop/releases/download/${VERSION}/htop-${VERSION}.tar.xz"
	],
	"deps": [
		"sys-libs/ncursesw"
	],
	"flags": {
		"LDFLAGS": [ "-L$(hl prefix-of sys-libs/ncursesw)/lib" ],
		"CFLAGS": [ "-I$(hl prefix-of sys-libs/ncursesw)/include" ]
	},
	"host": {
		"default": false,
		"debian8": [ "htop" ],
		"centos7": [ "htop" ],
		"gentoo": [ "sys-process/htop" ]
	},
