{
	"name": "sys-apps/modules",
	"homepage": "https://envmodules.io/",
	"inherit": "models/autotools",
	"vfetcher": {
		"mode": "github",
		"url": "github://envmodules/modules",
		"regexp": "v([0-9]+\\.[0-9]+\\.[0-9]+)"
	},
	"md5" : {},
	"subdir": "modules-${VERSION}",
	"urls" : [
		"https://github.com/envmodules/modules/releases/download/v${VERSION}/modules-${VERSION}.tar.gz"
	],
	"deps": [
		"dev-lang/tcl",
		"tclx? dev-tcltk/tclx"
	],
	"configure": {
		"": [ 
				"--with-tcl=$(hl prefix-of tcl)/lib",
				"--with-tclsh=$(hl prefix-of tcl)/bin/tclsh",
				"--with-tcl-lib=$(hl prefix-of tcl)/lib",
				"--with-tcl-inc=$(hl prefix-of tcl)/include",
				"--with-tcl-ver=$(source $(hl prefix-of tcl)/lib/tclConfig.sh && echo $TCL_VERSION)"
			],
		"X": [
				"--$with-x"
		],
		"-tclx":[
				"--without-tclx",
				"--with-tclx-ver=8.4"
		],
		"+tclx": [
			"--with-tclx=$(hl prefix-of tcl)/lib",
			"--with-tclx-lib=$(hl prefix-of tcl)/lib",
			"--with-tclx-inc=$(hl prefix-of tcl)/include",
			"--with-tclx-ver=$(source $(hl prefix-of tcl)/lib/tclxConfig.sh && echo $TCLX_VERSION)"
		],
		"+X": [
			"--with-tclx=$(hl prefix-of tcl)/lib"
		]
	},
	"steps": {
		"postinstall": [ 
			"run rm -f ${PREFIX}/Modules/current",
			"run ln -fs ${PREFIX}/init ${PREFIX}/Modules/current" 
		]
	},
	"use": [
		"-X",
		"-tclx"
	],
	"host": {
		"default": false,
		"debian8": false,
		"centos7": [ "environment-modules" ],
		"gentoo": [ "sys-cluster/modules" ]
	},
	"versions": [ 
		"5.6.1",
		"5.6.0",
		"5.5.0",
		"5.4.0",
		"5.3.1",
		"5.3.0",
		"5.2.0",
		"5.1.1",
		"5.1.0",
		"5.0.1",
		"5.0.0",
		"4.8.0",
		"4.7.1",
		"4.7.0",
		"4.6.1",
		"4.6.0",
		"4.5.3",
		"4.5.2",
		"4.5.1",
		"4.5.0",
		"4.4.1",
		"4.4.0",
		"4.3.1",
		"4.3.0",
		"4.2.5",
		"4.2.4",
		"4.2.3",
		"4.2.2",
		"4.2.1",
		"3.2.10"
	]
}
