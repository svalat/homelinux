{
	"name": "app-crypt/p11-kit",
	"homepage": "https://p11-glue.github.io/p11-glue/p11-kit.html",
	"inherit": "models/autotools",
	"vfetcher": {
		"mode": "github",
		"url": "github://p11-glue/p11-kit",
		"regexp": "([0-9]+\\.[0-9]+\\.?[0-9]*\\.?[0-9]*)"
	},
	"md5" : {},
	"subdir": "p11-kit-${VERSION}",
	"urls" : [
		"https://github.com/p11-glue/p11-kit/releases/download/${VERSION}/p11-kit-${VERSION}.tar.xz"
	],
	"deps": [
		"asn1? dev-libs/libtasn1",
		"libffi? dev-libs/libffi",
		"trust? app-misc/ca-certificates",
		"virtual/pkgconfig"
	],
	"configure": {
		"libffi": [ "$(hl_with $with libffi dev-libs/libffi)" ],
		"asn1": [ "$(hl_with $with libtasn1 dev-libs/libtasn1)" ],
		"debug": [ "--$enable-debug" ],
		"trust": [ "--$enable-trust", "--$enable-trust-module", "$(hl_with $with trust-paths ${PREFIX}/etc/ssl/certs/ca-certificates.crt)" ]
	},
	"host": {
		"default": false,
		"debian8": [ "p11-kit" ],
		"debian7": [ "p11-kit", "p11-kit-devel" ],
		"gentoo": [ "app-crypt/p11-kit" ]
	},
	"use": [ "+asn1", "+libffi", "debug", "trust" ],
	"tested": {
		"centos7": "0.23.2"
	},
	"versions": [ 
		"0.26.2",
		"0.26.1",
		"0.26.0",
		"0.25.10",
		"0.25.9",
		"0.25.8",
		"0.25.7",
		"0.25.6",
		"0.25.5",
		"0.25.4",
		"0.25.3",
		"0.25.2",
		"0.25.1",
		"0.25.0",
		"0.24.1",
		"0.24.0",
		"0.23.22",
		"0.23.21",
		"0.23.20",
		"0.23.19",
		"0.23.18.1",
		"0.23.18",
		"0.23.17",
		"0.23.16.1",
		"0.23.16",
		"0.23.15",
		"0.23.14",
		"0.23.13",
		"0.23.12",
		"0.23.11",
		"0.23.1"
	]
}
