{
	"name": "app-text/build-docbook-catalog",
	"homepage": "https://gitweb.gentoo.org/proj/build-docbook-catalog.git/",
	"versions": [
		"1.20"
	],
	"inherit": "models/autotools",
	"vfetcher": {
		"mode": "http",
		"url": "https://gitweb.gentoo.org/proj/build-docbook-catalog.git/refs/tags",
		"regexp": "v?([0-9]+\\.[0-9]+\\.?[0-9]*\\.?[0-9]*)"
	},
	"md5": {},
	"subdir": "build-docbook-catalog-${VERSION}",
	"urls": [
		"https://gitweb.gentoo.org/proj/build-docbook-catalog.git/snapshot/build-docbook-catalog-${VERSION}.tar.bz2"
	],
	"deps": [
		"dev-libs/libxml2"
	],
	"configure": {},
	"use": [
		""
	],
	"steps": {
		"configure": [
			"run sed -e \"s#^EPREFIX.*#EPREFIX=$PREFIX#\" -i  Makefile",
			"run sed -e \"s#^PREFIX.*#PREFIX=$PREFIX#\" -i  Makefile",
			"run sed -e 's/sbin/bin/g' -i Makefile"
		]
	},
	"host": {
		"default": true,
		"debian8": [
			"build-docbook-catalog"
		],
		"centos7": [ "docbook-utils" ],
		"gentoo": [ "app-text/build-docbook-catalog" ]
	},
	"tested": {
		"centos7": "1.21"
	}
}
