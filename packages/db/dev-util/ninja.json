{
	"api": 1,
	"name": "dev-util/ninja",
	"homepage": "https://ninja-build.org/",
	"inherit": "models/autotools",
	"vfetcher": {
		"mode": "github",
		"url": "github://ninja-build/ninja",
		"regexp": "v([0-9]+.[0-9]+.?[0-9]*.?[0-9]*)"
	},
	"steps": {
		"configure": [],
		"build": [
			"run ./configure.py --bootstrap --verbose"
		],
		"install": [
			"run cp ninja ${PREFIX}/bin"
		]
	},
	"md5": {},
	"subdir": "ninja-${VERSION}",
	"urls": [
		"github://ninja-build/ninja"
	],
	"deps": [
		"dev-util/re2c",
		"doc? app-text/asciidoc",
		"doc? app-doc/doxygen",
		"doc? dev-libs/libxslt",
		"test? dev-cpp/gtest",
		"emacs? virtual/emacs",
		"vim-syntax? app-editors/vim",
		"vim-syntax? app-editors/gvim",
		"zsh-completion? app-shells/zsh"
	],
	"configure": {},
	"use": [
		"doc",
		"emacs",
		"test",
		"vim-syntax",
		"zsh-completion"
	],
	"host": {
		"default": false,
		"debian8": [
			"ninja"
		],
		"centos7": [
			"ninja"
		],
		"gentoo": [
			"dev-util/ninja"
		]
	},
	"versions": [
		"1.13.2",
		"1.13.1",
		"1.13.0",
		"1.12.1",
		"1.12.0",
		"1.11.1",
		"1.11.0",
		"1.10.2",
		"1.10.1",
		"1.10.0",
		"1.9.0",
		"1.8.2",
		"1.7.2",
		"1.7.1",
		"1.6.0",
		"1.5.3",
		"1.5.1",
		"1.4.0",
		"1.3.4",
		"1.3.3",
		"1.3.2",
		"1.3.1",
		"1.3.0",
		"1.2.0",
		"1.1.0",
		"1.0.0"
	]
}
