	"inherit": "models/cmake",
	"vfetcher": {
		"mode": "github",
		"url": "github://memtt/malt",
		"regexp": "v([0-9]+\\.[0-9]+\\.?[0-9]*\\.?[0-9]*)"
	},
	"md5" : {},
	"subdir": "malt-${VERSION}",
