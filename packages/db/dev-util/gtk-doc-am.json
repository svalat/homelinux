{
	"name": "dev-util/gtk-doc-am",
	"homepage": "http://www.gtk.org/gtk-doc/",
	"inherit": "models/meson",
	"vfetcher": {
		"mode": "http-gnome-cache",
		"url": "https://download.gnome.org/sources/gtk-doc/cache.json",
		"regexp": "gtk-doc-([0-9]+\\.[0-9]+\\.?[0-9]*\\.?[0-9]*)\\.tar\\.((gz)|(xz)|(bz2))",
		"name": "gtk-doc"
	},
	"md5": {},
	"subdir": "gtk-doc-${VERSION}",
	"urls": [
		"https://download.gnome.org/sources/gtk-doc/$(echo ${VERSION} | cut -f 1-2 -d .)/gtk-doc-${VERSION}.tar.xz",
		"https://download.gnome.org/sources/gtk-doc/$(echo ${VERSION} | cut -f 1-2 -d .)/gtk-doc-${VERSION}.tar.bz2",
		"https://download.gnome.org/sources/gtk-doc/$(echo ${VERSION} | cut -f 1-2 -d .)/gtk-doc-${VERSION}.tar.gz"
	],
	"deps": [
		"sys-devel/autoconf",
		"dev-lang/perl",
		"virtual/pkgconfig"
	],
	"configure": {},
	"use": [
		""
	],
	"host": {
		"default": false,
		"debian8": [
			"gtk-doc-am"
		],
		"centos7": [
			"gtk-doc-am"
		],
		"gentoo": [
			"dev-util/gtk-doc-am"
		]
	},
