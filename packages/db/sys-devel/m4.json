{
	"name": "sys-devel/m4",
	"homepage": "https://www.gnu.org/software/m4/m4.html",
	"inherit": "models/autotools",
	"vfetcher": {
		"mode": "http",
		"url": "mirror://http-gnu/gnu/m4/",
		"regexp": "m4-([0-9]+\\.[0-9]+\\.?[0-9]*\\.?[0-9]*).(tar.bz2|tar.gz|tbz|tar.xz)"
	},
	"md5": {},
	"subdir": "m4-${VERSION}",
	"urls": [
		"mirror://http-gnu/gnu/m4/m4-${VERSION}.tar.bz2"
	],
	"deps": [
		"app-arch/xz-utils"
	],
	"configure": {
		"": [
			"--enable-changeword"
		]
	},
	"use": [
		"examples"
	],
	"host": {
		"default": true,
		"debian8": [
			"m4"
		],
		"centos7": [ "m4" ],
		"gentoo": [ "sys-devel/m4" ]
	},
	"versions": [
		"1.4.21",
		"1.4.20",
		"1.4.19",
		"1.4.18",
		"1.4.17",
		"1.4.16",
		"1.4.15",
		"1.4.14",
		"1.4.13",
		"1.4.12",
		"1.4.11",
		"1.4.10",
		"1.4.9",
		"1.4.8",
		"1.4.7",
		"1.4.6",
		"1.4.5",
		"1.4.4",
		"1.4.3",
		"1.4.2",
		"1.4.1",
		"1.4"
	]
}
